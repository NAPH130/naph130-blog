---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ParticleClock from '@/components/ParticleClock';
import IntroBio from '@/components/IntroBio';
import { Mail } from 'lucide-react';
---

<BaseLayout title="简介 - NAPH130's Blog" currentPath="/intro">
  <div class="flex items-center justify-center min-h-[calc(100vh-5rem)] p-4 sm:p-8 lg:p-12 pb-12 sm:pb-20">
    {/* 中间磨砂玻璃悬浮窗 */}
    <div
      class="relative w-full max-w-[1080px] -translate-y-3 sm:-translate-y-7 bg-white/20 backdrop-blur-2xl border border-white/40 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.35)] p-8 sm:p-12 text-white rounded-3xl select-none transition-transform"
    >
      <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-8 sm:gap-12 items-center">
        {/* 左侧：头像与 4 个适中灰度社交微块 */}
        <div class="flex flex-col items-center justify-center shrink-0 mx-auto md:mx-0 w-full md:w-auto my-auto">
          {/* 头像 (256px + 圆角 rounded-2xl + 居中) */}
          <div class="w-56 h-56 sm:w-64 sm:h-64 border border-white/50 shadow-lg bg-white/10 rounded-2xl overflow-hidden shrink-0 relative">
            <img
              src="/avatar.jpg"
              alt="Avatar"
              class="w-full h-full object-cover select-none pointer-events-none rounded-2xl"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            {/* 头像加载失败备用占位 */}
            <div class="w-full h-full hidden items-center justify-center bg-white/10 font-mono font-bold text-3xl text-white rounded-2xl">
              NAPH
            </div>
          </div>

          {/* 左下 4 个小块：GitHub、邮件、QQ、Codeforces */}
          <div class="grid grid-cols-4 gap-3 sm:gap-4 mt-6 w-56 sm:w-64">
            {/* 1. GitHub */}
            <a
              href="https://github.com/NAPHthalene130"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              title="GitHub: NAPHthalene130"
              class="h-12 sm:h-14 flex items-center justify-center border border-white/40 bg-white/15 hover:bg-white hover:text-neutral-900 text-neutral-600 hover:scale-105 active:scale-95 transition-all rounded-xl shadow-xs"
            >
              <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </a>

            {/* 2. 邮件 */}
            <a
              href="mailto:naph130@outlook.com"
              aria-label="Email"
              title="Email: naph130@outlook.com"
              class="h-12 sm:h-14 flex items-center justify-center border border-white/40 bg-white/15 hover:bg-white hover:text-neutral-900 text-neutral-600 hover:scale-105 active:scale-95 transition-all rounded-xl shadow-xs"
            >
              <Mail className="w-6 h-6 sm:w-7 sm:h-7 stroke-current" />
            </a>

            {/* 3. QQ */}
            <a
              href="tencent://message/?uin=1301537275&Site=&Menu=yes"
              aria-label="QQ"
              title="QQ: 1301537275"
              class="h-12 sm:h-14 flex items-center justify-center border border-white/40 bg-white/15 hover:bg-white hover:text-neutral-900 text-neutral-600 hover:scale-105 active:scale-95 transition-all rounded-xl shadow-xs"
            >
              <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current" viewBox="0 0 256 256">
                <g transform="translate(1.4065934065934016 1.4065934065934016) scale(2.81 2.81)">
                  <path d="M 45 0 L 45 0 C 20.147 0 0 20.147 0 45 v 0 c 0 24.853 20.147 45 45 45 h 0 c 24.853 0 45 -20.147 45 -45 v 0 C 90 20.147 69.853 0 45 0 z M 65.484 61.059 c -1.125 0.136 -4.381 -5.151 -4.381 -5.151 c 0 3.062 -1.578 7.055 -4.989 9.94 c 1.277 0.393 2.842 0.997 3.849 1.741 c 0.903 0.666 0.79 1.346 0.627 1.62 c -0.714 1.206 -12.257 0.77 -15.589 0.395 c -3.332 0.375 -14.875 0.811 -15.589 -0.395 c -0.163 -0.274 -0.276 -0.954 0.628 -1.62 c 1.006 -0.743 2.57 -1.347 3.847 -1.74 c -3.411 -2.885 -4.99 -6.879 -4.99 -9.941 c 0 0 -3.255 5.286 -4.38 5.15 c -0.524 -0.063 -1.213 -2.895 0.913 -9.737 c 0.446 -1.434 1.054 -3.108 1.671 -4.715 l 0.001 0 c 0 0 -0.001 0 -0.001 0 l 2.25 -5.615 c 0 0 0.001 0 0.001 0 l -0.001 0 c -0.002 -0.065 -0.03 -1.17 -0.03 -1.741 C 29.32 29.649 33.853 20 45 20 c 11.147 0 15.68 9.649 15.68 19.252 c 0 0.57 -0.028 1.675 -0.029 1.741 l 2.25 5.615 c 0 0 -0.001 0 -0.001 0 l 0.001 0 c 0.616 1.607 1.225 3.28 1.671 4.715 C 66.697 58.164 66.008 60.996 65.484 61.059 z"/>
                </g>
              </svg>
            </a>

            {/* 4. Codeforces */}
            <a
              href="https://codeforces.com/profile/NAPHthalene130"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Codeforces"
              title="Codeforces: NAPHthalene130"
              class="h-12 sm:h-14 flex items-center justify-center border border-white/40 bg-white/15 hover:bg-white hover:text-neutral-900 text-neutral-600 hover:scale-105 active:scale-95 transition-all rounded-xl shadow-xs"
            >
              <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current" viewBox="0 0 24 24">
                <path d="M4.5 7.5A1.5 1.5 0 0 1 6 9v10.5A1.5 1.5 0 0 1 4.5 21h-3A1.5 1.5 0 0 1 0 19.5V9a1.5 1.5 0 0 1 1.5-1.5h3zm9-4.5A1.5 1.5 0 0 1 15 4.5v15a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 19.5v-15A1.5 1.5 0 0 1 10.5 3h3zm9 7.5A1.5 1.5 0 0 1 24 12v7.5a1.5 1.5 0 0 1-1.5 1.5h-3a1.5 1.5 0 0 1-1.5-1.5V12a1.5 1.5 0 0 1 1.5-1.5h3z"/>
              </svg>
            </a>
          </div>
        </div>

        {/* 右侧：纯粒子时间与正文简介 */}
        <div class="flex flex-col justify-between flex-1 min-w-0">
          {/* 右上：粒子时间 (齐宽舒展无框) */}
          <div class="h-28 sm:h-36 w-full relative flex items-center justify-center overflow-hidden">
            <ParticleClock client:load />
          </div>

          {/* 右下：正文简介 (恢复上一轮的轻透磨砂底色 bg-white/10 与 border-white/40) */}
          <div class="mt-4 sm:mt-6 p-8 sm:p-10 border border-white/40 bg-white/10 backdrop-blur-md flex-1 min-h-[190px] sm:min-h-[220px] flex items-center rounded-2xl shadow-xs">
            <IntroBio client:load />
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
