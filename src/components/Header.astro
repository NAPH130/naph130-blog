---
import { t } from '@/i18n';

interface Props {
  locale?: string;
}

const { locale = 'zh_cn' } = Astro.props;
---

<header
  class="fixed top-0 left-0 right-0 z-50 h-14 bg-white/45 dark:bg-neutral-900/40 backdrop-blur-md border-b border-white/20 dark:border-white/10 shadow-sm transition-colors duration-300 select-none"
>
  <div class="max-w-7xl mx-auto h-full px-4 sm:px-8 flex items-center justify-between">
    <!-- 左侧：博客名称 -->
    <a
      href="/"
      class="group flex items-center gap-1 text-lg sm:text-xl font-bold font-serif tracking-wide text-neutral-800 dark:text-neutral-100 hover:opacity-80 transition-opacity"
    >
      <span>NAPH130's</span>
      <span class="text-sky-500 font-sans font-medium text-base sm:text-lg">Blog</span>
    </a>

    <!-- 中间：导航链接（目前仅首页） -->
    <nav class="flex items-center gap-2">
      <a
        href="/"
        class="relative flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-sm font-medium text-sky-600 dark:text-sky-400 bg-sky-500/10 border border-sky-500/20 shadow-sm transition-all hover:bg-sky-500/15"
      >
        <!-- 首页图标 -->
        <svg
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>{t('nav.home', locale)}</span>
        <!-- 激活小蓝点 -->
        <span
          class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-sky-500 shadow-sm"
          aria-hidden="true"
        ></span>
      </a>
    </nav>

    <!-- 右侧：设置按钮 -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        aria-label="设置"
        class="p-2 rounded-full text-neutral-700 dark:text-neutral-300 hover:bg-black/5 dark:hover:bg-white/10 active:scale-95 transition-all focus:outline-none focus:ring-2 focus:ring-sky-500/40"
      >
        <!-- 设置齿轮图标 -->
        <svg
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
          ></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </button>
    </div>
  </div>
</header>
